name: did:iden3:billions:main:2VumTmNqobfG4uNqyBS2Re98nsgQ9qFDJ9qTEN1dqp

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'Kelvin'
        required: true
        default: 'Kelvin'
      agent_description:
        description: 'Kelvin'
        required: true
        default: 'cloud AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '20'

      - name: Step 1 - Install ClawHub skill
        run: npx clawhub@latest install verified-agent-identity

      - name: Install script dependencies
        run: |
          cd scripts
          npm install

      - name: Kelvin
        run: node scripts/createNewEthereumIdentity.js

      - name: Kelvin
        run: |
          node scripts/manualLinkHumanToAgent.js --challenge '{"name": "Kelvin", "description": "cloud AI Agent"}'
